{
  "name": "mediapipe-test",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build:stage": "pnpm run format && pnpm run lint && pnpm run stylelint && pnpm run type-check && vite build --mode staging && node scripts/bump-and-tag.mjs --mode stage",
    "build:uat": "pnpm run format && pnpm run lint && pnpm run stylelint && pnpm run type-check && vite build --mode uat && node scripts/bump-and-tag.mjs --mode uat",
    "build:prod": "pnpm run format && pnpm run lint && pnpm run stylelint && pnpm run type-check && vite build --mode production && node scripts/bump-and-tag.mjs --mode prod",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.js,.vue src",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "deploy": "pnpm build:stage && gh-pages -d dist"
  },
  "lint-staged": {
    "src/**/*.{ts,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss,vue}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@mediapipe/hands": "^0.4.1675469240",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "pinia": "^3.0.3",
    "three": "^0.185.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.1.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/compat": "^1.4.1",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.4",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^10.0.0",
    "fs-extra": "^11.3.6",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "only-allow": "^1.2.1",
    "postcss": "^8.4.40",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.80.0",
    "stylelint": "^16.19.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.2.2",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^8.1.1",
    "vite-svg-loader": "^5.1.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.5"
  },
  "volta": {
    "node": "22.17.0"
  }
}
